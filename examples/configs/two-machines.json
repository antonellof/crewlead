{
  "providers": {
    "studio": { "baseUrl": "http://127.0.0.1:8080/v1", "maxConcurrency": 3 },
    "laptop": { "baseUrl": "http://192.168.1.20:8080/v1", "maxConcurrency": 2 }
  },
  "workers": {
    "builder": {
      "description": "Qwen 3.8 27B on this machine.",
      "provider": "studio",
